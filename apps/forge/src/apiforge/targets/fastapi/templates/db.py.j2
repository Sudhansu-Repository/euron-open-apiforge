"""The database engine and sessions.

Yours: APIForge creates this file once and never overwrites it. DATABASE_URL picks the
database (SQLite by default, Postgres in Docker Compose). Outside production the tables are
created at startup; in production, run the migrations: ``uv run alembic upgrade head``.
"""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from typing import Any

from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine

from app.config import DatabaseSettings, get_settings


def engine_options(settings: DatabaseSettings) -> dict[str, Any]:
    """Pool and timeout settings for a server database (SQLite has no use for them)."""
    options: dict[str, Any] = {"pool_pre_ping": True}
    if settings.database_url.startswith("sqlite"):
        return options
    options.update(pool_size=settings.db_pool_size, max_overflow=settings.db_max_overflow)
    if settings.database_url.startswith("postgresql+asyncpg") and settings.db_statement_timeout_ms:
        # A query running longer than this is cancelled by Postgres instead of holding a
        # connection forever.
        timeout = str(settings.db_statement_timeout_ms)
        options["connect_args"] = {"server_settings": {"statement_timeout": timeout}}
    return options


_settings = get_settings()
engine = create_async_engine(_settings.database_url, **engine_options(_settings))
SessionLocal = async_sessionmaker(engine, expire_on_commit=False)


@asynccontextmanager
async def session_scope() -> AsyncIterator[AsyncSession]:
    """A session in a transaction: committed when the block ends, rolled back on error."""
    async with SessionLocal() as session, session.begin():
        yield session


async def create_tables() -> None:
    from app.generated.db_models import Base

    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
