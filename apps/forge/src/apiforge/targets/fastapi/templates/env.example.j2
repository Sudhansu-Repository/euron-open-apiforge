# Copy to .env for local development. Never commit .env.
APP_ENV=development
# Comma-free JSON list of allowed browser origins, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
# /docs and /openapi.json: on outside production, off in production unless true.
# DOCS_ENABLED=
# Largest request body in bytes (413 above it); 0 turns the limit off.
MAX_BODY_BYTES=10485760
{% if has_bearer %}
# A random value of at least 32 characters (openssl rand -hex 32).
JWT_SECRET=
# HS256, HS384 or HS512. Optional: JWT_AUDIENCE, JWT_ISSUER (verified when set).
JWT_ALGORITHM=HS256
JWT_LEEWAY_SECONDS=30
{% endif %}
{% if has_apikey %}
# JSON list of accepted API keys, each at least 24 characters.
API_KEYS=[]
{% endif %}
{% if has_basic %}
# JSON object of basic auth users and passwords (at least 16 characters).
BASIC_USERS={}
{% endif %}
{% if options.db %}
# SQLite for development; production requires a real database (Postgres).
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Postgres pool and statement timeout:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=30000
{% endif %}
