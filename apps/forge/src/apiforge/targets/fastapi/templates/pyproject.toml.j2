[project]
name = {{ slug|yaml_str }}
version = {{ py_version|yaml_str }}
description = {{ ("A FastAPI service for " ~ api.title ~ ", generated by Euron Open APIForge")|yaml_str }}
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
  "fastapi>=0.162,<1",
  "uvicorn[standard]>=0.54",
  "pydantic>=2.14,<3",
  "pydantic-settings>=2.16",
  "email-validator>=2.2",
  "python-multipart>=0.0.20",
{% if has_bearer %}
  "pyjwt>=2.15",
{% endif %}
{% if options.db %}
  "sqlalchemy[asyncio]>=2.1",
  "alembic>=1.20",
  "aiosqlite>=0.21",
  "asyncpg>=0.30",
{% endif %}
]

[dependency-groups]
dev = [
  "pytest>=9.1",
  "pytest-asyncio>=1.4",
  "httpx>=0.28",
  "ruff>=0.17",
  "mypy>=2.4",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]
pythonpath = ["."]

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "SIM"]
ignore = ["B008"]

[tool.ruff.lint.per-file-ignores]
# Generated code keeps long literals (patterns, descriptions) on one line.
"app/generated/**" = ["E501"]
"tests/generated/**" = ["E501"]
# Handler modules import the common types up front, so a stub can use them right away.
"app/handlers/**" = ["F401"]

[tool.ruff.lint.isort]
known-first-party = ["app", "tests"]

[tool.mypy]
strict = true
python_version = "3.12"
plugins = ["pydantic.mypy"]
