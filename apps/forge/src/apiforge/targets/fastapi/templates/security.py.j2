# One credential a route needs: what the scheme's dependency returned, and the scopes the
# spec requires of it.
Need = tuple[Principal | None, list[str]]


def require(*alternatives: list[Need], challenge: str | None = None) -> Principal:
    """The principal of the first alternative whose credentials are all present and valid.

    Alternatives are OR; the credentials inside one are AND. 403 when an alternative
    authenticated but lacks a scope and none succeeded; 401 when none authenticated.
    """
    missing: set[str] = set()
    for needs in alternatives:
        principals = [principal for principal, _ in needs]
        if not needs or any(principal is None for principal in principals):
            continue
        lacking = {
            scope
            for principal, scopes in needs
            for scope in scopes
            if principal is not None and scope not in principal.scopes
        }
        if not lacking:
            first = principals[0]
            assert first is not None
            return first
        missing |= lacking
    if missing:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Missing scope: " + " ".join(sorted(missing)),
        )
    raise HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="Missing or invalid credentials",
        headers={"WWW-Authenticate": challenge} if challenge else None,
    )


async def unsupported() -> Principal:
    """A requirement this server cannot check: refused, never let through unauthenticated."""
    raise HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail="This operation requires a security scheme the server does not support",
    )
{% if "basic" in kinds %}


class _LenientBasic(HTTPBasic):
    """HTTP basic that reads a malformed header as no credential, so another alternative can
    still accept the request (FastAPI's HTTPBasic answers 401 itself)."""

    async def __call__(  # type: ignore[override]  # as HTTPBasic itself
        self, request: HTTPConnection
    ) -> HTTPBasicCredentials | None:
        try:
            return await super().__call__(request)
        except HTTPException:
            return None
