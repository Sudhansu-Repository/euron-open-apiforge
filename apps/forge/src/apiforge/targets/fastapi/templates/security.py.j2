)


async def {{ s.name }}(
    credentials: Annotated[HTTPAuthorizationCredentials | None, Depends(_{{ s.name }})],
) -> Principal | None:
    if credentials is None:
        return None
    return await auth.verify_{{ s.name }}(credentials.credentials)
