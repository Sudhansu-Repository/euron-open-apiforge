{% endif %}
    scheme_name={{ s.wire|lit }},
    description={{ s.description|lit }},
    auto_error=False,
)


async def {{ s.name }}(
    authorization: Annotated[str | None, Depends(_{{ s.name }})],
) -> Principal | None:
    # Scopes are checked in require(), so a token without them does not stop another
    # alternative from accepting the request.
    if not authorization or not authorization.lower().startswith("bearer "):
        return None
    return await auth.verify_{{ s.name }}(authorization[7:].strip())
