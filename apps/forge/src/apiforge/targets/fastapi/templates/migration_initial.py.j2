from collections.abc import Sequence

import sqlalchemy as sa
from alembic import op

revision: str = "0001"
down_revision: str | None = None
branch_labels: str | Sequence[str] | None = None
depends_on: str | Sequence[str] | None = None


def upgrade() -> None:
{% for res in resources %}
    op.create_table(
        {{ res.table|lit }},
{% for col in res.columns %}
{% if col.is_id %}
        sa.Column({{ col.column|lit }}, sa.{{ "Integer" if res.id_type == "int" else "Uuid" if res.id_type == "UUID" else "String" }}(), primary_key=True{{ ", autoincrement=True" if res.id_type == "int" else "" }}),
{% else %}
        sa.Column({{ col.column|lit }}, sa.{{ col.sa_type if "(" in col.sa_type else col.sa_type ~ "()" }}, nullable={{ col.nullable }}),
{% endif %}
{% endfor %}
    )
{% endfor %}


def downgrade() -> None:
{% for res in resources|reverse %}
    op.drop_table({{ res.table|lit }})
{% endfor %}
