# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv==0.11.19
WORKDIR /srv
# uv.lock pins every dependency: commit it (uv sync writes it) and the image installs
# exactly that set, failing if it is out of date with pyproject.toml. Without it the build
# still works, resolving the latest allowed versions, and says so.
COPY pyproject.toml uv.lock* ./
RUN if [ -f uv.lock ]; then \
      uv sync --locked --no-dev --no-install-project; \
    else \
      echo "warning: no uv.lock, dependencies are not pinned; run uv sync and commit uv.lock" >&2; \
      uv sync --no-dev --no-install-project; \
    fi
COPY app ./app
{% if options.db %}
COPY alembic.ini ./
COPY migrations ./migrations
{% endif %}
RUN useradd --system --uid 10001 api && chown -R api /srv
USER api
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD ["/srv/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"]
CMD ["/srv/.venv/bin/uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
