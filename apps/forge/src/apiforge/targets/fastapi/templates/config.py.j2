"""Settings, read from environment variables (and a .env file in development).

Yours: APIForge creates this file once and never overwrites it. In production
(APP_ENV=production) the app refuses to start with unsafe settings.
"""

from __future__ import annotations

from functools import lru_cache
from typing import Literal

from pydantic import Field{{ ", SecretStr" if (has_bearer or has_apikey or has_basic) else "" }}, model_validator
from pydantic_settings import BaseSettings, SettingsConfigDict
{% if options.db %}

SQLITE_DEFAULT = "sqlite+aiosqlite:///./app.db"


class DatabaseSettings(BaseSettings):
    """Only what the database needs, so the migrations run without the app's secrets."""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    database_url: str = SQLITE_DEFAULT
    # Connection pool and query limits (Postgres; SQLite ignores them).
    db_pool_size: int = Field(default=5, ge=1)
    db_max_overflow: int = Field(default=10, ge=0)
    db_statement_timeout_ms: int = Field(default=30_000, ge=0)  # 0 turns the limit off
{% endif %}


class Settings({{ "DatabaseSettings" if options.db else "BaseSettings" }}):
    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    app_env: Literal["development", "test", "production"] = "development"
    cors_origins: list[str] = Field(default_factory=list)
    # /docs, /redoc and /openapi.json: on outside production, off in production unless true.
    docs_enabled: bool | None = None
    # Largest request body accepted, in bytes (413 above it); 0 turns the limit off.
    max_body_bytes: int = Field(default=10 * 1024 * 1024, ge=0)
{% if has_bearer %}
    # Tokens are JSON Web Tokens signed with this secret (HS256 by default). OpenID Connect
    # and OAuth2 tokens are verified with it too, not fetched keys (JWKS).
    jwt_secret: SecretStr = SecretStr("")
    jwt_algorithm: Literal["HS256", "HS384", "HS512"] = "HS256"
    jwt_audience: str | None = None
    jwt_issuer: str | None = None  # when set, a token's iss claim must equal it
    jwt_leeway_seconds: int = Field(default=30, ge=0)  # clock skew allowed on exp and nbf
{% endif %}
{% if has_apikey %}
    # Accepted API keys, as a JSON list: API_KEYS='["key-one", "key-two"]'.
    api_keys: list[SecretStr] = Field(default_factory=list)
{% endif %}
{% if has_basic %}
    # HTTP basic users, as a JSON object: BASIC_USERS='{"admin": "a-long-password"}'.
    basic_users: dict[str, SecretStr] = Field(default_factory=dict)
{% endif %}

    @model_validator(mode="after")
    def _refuse_unsafe_production(self) -> Settings:
        if self.app_env != "production":
            return self
        problems: list[str] = []
{% if has_bearer %}
        if len(self.jwt_secret.get_secret_value()) < 32:
            problems.append("JWT_SECRET must be a random value of at least 32 characters")
{% endif %}
{% if has_apikey %}
        if any(len(k.get_secret_value()) < 24 for k in self.api_keys):
            problems.append("every API key must be at least 24 characters")
{% endif %}
{% if has_basic %}
        if any(len(p.get_secret_value()) < 16 for p in self.basic_users.values()):
            problems.append("every basic auth password must be at least 16 characters")
{% endif %}
{% if options.db %}
        if "database_url" not in self.model_fields_set or self.database_url.startswith("sqlite"):
            problems.append("DATABASE_URL must be set to your production database, not SQLite")
{% endif %}
        if "*" in self.cors_origins:
            problems.append("CORS_ORIGINS must list origins, not '*'")
        if problems:
            raise ValueError("Unsafe production settings: " + "; ".join(problems))
        return self


@lru_cache
def get_settings() -> Settings:
    return Settings()
